<div class="container my-5">

  <!-- places header in yellow box -->
  <div class="p-4 mb-4 bg-warning text-dark rounded shadow-sm text-center">
    <h1 class="mb-0">Help!</h1>
  </div>

  <!-- drop down/ accordion button that when clicked on shows you info on how to receive help -->
  <div class="row">
    <div class="col-md-8 mx-auto">

      <div class="accordion" id="helpAccordion">

        <!-- Item 1 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button collapsed" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseOne"
                    aria-expanded="false"
                    aria-controls="collapseOne">
              How to use the app
            </button>
          </h2>

          <div id="collapseOne"
               class="accordion-collapse collapse"
               aria-labelledby="headingOne"
               data-bs-parent="#helpAccordion">

            <div class="accordion-body">
              Explore the navigation menu to access different features.
              If you're still confused, return here or go to the 'contact us' page.
            </div>
          </div>
        </div>

        <!-- Item 2 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseTwo"
                    aria-expanded="false"
                    aria-controls="collapseTwo">
              Where to get support
            </button>
          </h2>

          <div id="collapseTwo"
               class="accordion-collapse collapse"
               aria-labelledby="headingTwo"
               data-bs-parent="#helpAccordion">

            <div class="accordion-body">
              You can get support through the contact page.
            </div>
          </div>
        </div>

        <!-- Item 3 -->
        <div class="accordion-item">
          <h2 class="accordion-header" id="headingThree">
            <button class="accordion-button collapsed" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseThree"
                    aria-expanded="false"
                    aria-controls="collapseThree">
              Tips for getting started
            </button>
          </h2>

          <div id="collapseThree"
               class="accordion-collapse collapse"
               aria-labelledby="headingThree"
               data-bs-parent="#helpAccordion">

            <div class="accordion-body">
              Start by exploring the dashboard, then try creating or viewing posts.
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>