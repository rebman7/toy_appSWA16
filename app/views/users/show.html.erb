<p style="color: green"><%= notice %></p>

<%= render @user %>

<div>

  <a href="<%= boost_user_url(@user) %>" class="btn btn-outline-success btn-sm">Boost User</a>
  <!--<a href="<%#= edit_user_url(@user) %>" class="btn btn-outline-warning btn-sm">Edit User</a> -->
  <%#= button_to "Delete User", @user, method: :delete, class: "btn btn-outline-danger btn-sm" %>
  <%#= button_to "Log Out", logout_path, method: :delete, class: "btn btn-outline-danger btn-sm" %>

</div>

<div id="microposts">
  <% @post.each do |micropost| %>
    <%= render micropost %>
  <% end %>
</div>
